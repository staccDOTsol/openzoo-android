<?xml version='1.0' encoding='utf-8'?>
<widget id="com.example.cordovaseeker" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>CordovaSeeker</name>
    <description>Open-source Seeker game template — Cordova + native Mobile Wallet Adapter, no Unity required</description>
    <author href="https://github.com/your-org/cordovaseeker">
        Your Name
    </author>

    <!-- Local shell handles wallet, loads game in iframe -->
    <content src="index.html" />

    <!-- If you host your game remotely, add its domain here:
    <allow-navigation href="https://yourgame.example.com/*" />
    <access origin="https://yourgame.example.com" /> -->

    <!-- Open wallet / external links in system browser -->
    <allow-intent href="https://*/*" />
    <!-- MWA uses solana-wallet:// scheme to discover & connect native wallet apps -->
    <allow-intent href="solana-wallet://*" />

    <!-- Fullscreen immersive mode -->
    <preference name="Fullscreen" value="true" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#000000" />
    <preference name="StatusBarStyle" value="lightcontent" />
    <preference name="KeepRunning" value="true" />
    <preference name="Orientation" value="default" />
    <preference name="BackgroundColor" value="0xff0a0a18" />
    <preference name="SplashScreenDelay" value="0" />
    <preference name="FadeSplashScreen" value="false" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="DisallowOverscroll" value="true" />

    <!-- Android specific -->
    <platform name="android">
        <preference name="AndroidWindowSplashScreenBackground" value="#0a0a18" />
        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
        <!-- Allow CDN imports (esm.sh) from file:// origin -->
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <!-- Immersive sticky hides nav + status bars -->
        <preference name="immersiveMode" value="true" />
        <!-- Allow video autoplay without user gesture -->
        <preference name="MediaPlaybackRequiresUserAction" value="false" />
        <!-- Use hardware back button to quit (no history to navigate) -->
        <preference name="OverrideBackButton" value="true" />
        <!-- singleTask: relaunches (e.g. returning from the wallet app) reuse the existing activity instead of recreating it -->
        <preference name="AndroidLaunchMode" value="singleTask" />

        <!-- Icons -->
        <icon density="ldpi" src="res/icon/android/ldpi.png" />
        <icon density="mdpi" src="res/icon/android/mdpi.png" />
        <icon density="hdpi" src="res/icon/android/hdpi.png" />
        <icon density="xhdpi" src="res/icon/android/xhdpi.png" />
        <icon density="xxhdpi" src="res/icon/android/xxhdpi.png" />
        <icon density="xxxhdpi" src="res/icon/android/xxxhdpi.png" />
    </platform>
</widget>
