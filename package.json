{
  "name": "fun.openzoo.android",
  "displayName": "OpenZoo",
  "version": "1.0.0",
  "description": "OpenZoo for Android 14+ / Google Play — grokui on a phone (threads, chat, wallet, attach). Paid from Phantom via Mobile Wallet Adapter and x402.",
  "main": "index.js",
  "scripts": {
    "test": "node test/rails.test.js && node test/wrap.test.js && node test/bind.test.js && node test/smoke-gateway.js",
