    "test:wrap": "node test/wrap.test.js",
    "test:bind": "node test/bind.test.js",
    "test:gateway": "node test/smoke-gateway.js",
    "build": "cordova build android",
    "build:release": "cordova build android --release",
    "run": "cordova run android",
    "clean": "cordova clean android",
    "requirements": "cordova requirements android"
  },
  "keywords": [
    "ecosystem:cordova",
    "solana",
    "phantom",
    "mobile-wallet-adapter",
    "x402",
    "openzoo"
  ],
