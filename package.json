  "devDependencies": {
    "cordova-android": "^14.0.1",
    "cordova-plugin-mwa": "file:cordova-plugin-mwa"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-mwa": {}
    }
  }
